38330>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38333>>>        Case Begin
38333>>>            Case (NavigateData.eNavigateType = nfFromMain)
38335>>>                // If from main, this is a propbably a main file Select to Zoom.
38335>>>                Case Break
38336>>>
38336>>>            Case (NavigateData.eNavigateType = nfFromParent)
38339>>>                // If from parent, this is a constrained drill down.
38339>>>                Case Break
38340>>>
38340>>>            Case (NavigateData.eNavigateType = nfFromChild)
38343>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38343>>>                Case Break
38344>>>
38344>>>            Case Else // must be nfUndefined
38344>>>
38344>>>        Case End
38344>>>
38344>>>        Send SetActionButtons
38345>>>
38345>>>    End_Procedure
38346>>>
