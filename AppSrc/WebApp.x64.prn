38300>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38300>>>                Case Break
38301>>>
38301>>>            Case Else // must be nfUndefined
38301>>>
38301>>>        Case End
38301>>>
38301>>>        Send SetActionButtons
