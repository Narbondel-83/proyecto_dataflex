37536>>>    Procedure SetActionButtons
37539>>>        tWebNavigateData NavigateData
37539>>>        tWebNavigateData NavigateData
37539>>>        Boolean bHasRecord
37539>>>        Handle hoDD
37539>>>
37539>>>        Get Server to hoDD
37540>>>        Get GetNavigateData to NavigateData
37541>>>        Get HasRecord of hoDD to bHasRecord
37542>>>
37542>>>        // let's hide all buttons and then Show the ones we want
37542>>>        WebSet pbRender of oEditBtn to False
37543>>>        WebSet pbRender of oSaveBtn to False
37544>>>        WebSet pbRender of oCancelChangesBtn to False
37545>>>        WebSet pbRender of oDeleteBtn to False
37546>>>
37546>>>        If (NavigateData.bReadOnly) Begin
37548>>>            WebSet pbRender of oEditBtn to True
37549>>>        End
37549>>>>
37549>>>        Else Begin
37550>>>            WebSet pbRender of oSaveBtn to True
37551>>>            WebSet pbRender of oCancelChangesBtn to True
37552>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37553>>>        End
37553>>>>
37553>>>    End_Procedure
