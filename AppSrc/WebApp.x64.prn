37564>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37567>>>        Case Begin
37567>>>            Case (NavigateData.eNavigateType = nfFromMain)
37569>>>                // If from main, this is a propbably a main file Select to Zoom.
37569>>>                Case Break
37570>>>
37570>>>            Case (NavigateData.eNavigateType = nfFromParent)
37573>>>                // If from parent, this is a constrained drill down.
37573>>>                Case Break
37574>>>
37574>>>            Case (NavigateData.eNavigateType = nfFromChild)
37577>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37577>>>                Case Break
37578>>>
37578>>>            Case Else // must be nfUndefined
37578>>>
37578>>>        Case End
37578>>>
37578>>>        Send SetActionButtons
37579>>>
37579>>>    End_Procedure
