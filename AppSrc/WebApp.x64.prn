37841>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37844>>>>>>>        Case Begin
37844>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37846>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37846>>>>>>>                Case Break
37847>>>>>>>
37847>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37850>>>>>>>                // If from parent, this is a constrained drill down.
37850>>>>>>>                Case Break
37851>>>>>>>
37851>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37854>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37854>>>>>>>                Case Break
37855>>>>>>>
37855>>>>>>>            Case Else // must be nfUndefined
37855>>>>>>>
37855>>>>>>>        Case End
37855>>>>>>>
37855>>>>>>>        Send SetActionButtons
37856>>>>>>>
37856>>>>>>>    End_Procedure
37857>>>>>>>
37857>>>>>>>End_Object 
