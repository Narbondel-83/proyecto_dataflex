37932>>>        Get GetNavigateData to NavigateData
37933>>>        Get HasRecord of hoDD to bHasRecord
37934>>>
37934>>>        // let's hide all buttons and then Show the ones we want
37934>>>        WebSet pbRender of oEditBtn to False
37935>>>        WebSet pbRender of oSaveBtn to False
37936>>>        WebSet pbRender of oCancelChangesBtn to False
37937>>>        WebSet pbRender of oDeleteBtn to False
37938>>>
37938>>>        If (NavigateData.bReadOnly) Begin
37940>>>            WebSet pbRender of oEditBtn to True
37941>>>        End
37941>>>>
37941>>>        Else Begin
37942>>>            WebSet pbRender of oSaveBtn to True
37943>>>            WebSet pbRender of oCancelChangesBtn to True
37944>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37945>>>        End
37945>>>>
37945>>>    End_Procedure
