37598>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37601>>>        Case Begin
37601>>>            Case (NavigateData.eNavigateType = nfFromMain)
37603>>>                // If from main, this is a propbably a main file Select to Zoom.
37603>>>                Case Break
37604>>>
37604>>>            Case (NavigateData.eNavigateType = nfFromParent)
37607>>>                // If from parent, this is a constrained drill down.
37607>>>                Case Break
37608>>>
37608>>>            Case (NavigateData.eNavigateType = nfFromChild)
37611>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37611>>>                Case Break
37612>>>
37612>>>            Case Else // must be nfUndefined
37612>>>
37612>>>        Case End
37612>>>
37612>>>        Send SetActionButtons
37613>>>
37613>>>    End_Procedure
