37885>>>        tWebNavigateData NavigateData
37885>>>        tWebNavigateData NavigateData
37885>>>        Boolean bHasRecord
37885>>>        Handle hoDD
37885>>>
37885>>>        Get Server to hoDD
37886>>>        Get GetNavigateData to NavigateData
37887>>>        Get HasRecord of hoDD to bHasRecord
37888>>>
37888>>>        // let's hide all buttons and then Show the ones we want
37888>>>        WebSet pbRender of oEditBtn to False
37889>>>        WebSet pbRender of oSaveBtn to False
37890>>>        WebSet pbRender of oCancelChangesBtn to False
37891>>>        WebSet pbRender of oDeleteBtn to False
37892>>>
37892>>>        If (NavigateData.bReadOnly) Begin
37894>>>            WebSet pbRender of oEditBtn to True
37895>>>        End
37895>>>>
37895>>>        Else Begin
37896>>>            WebSet pbRender of oSaveBtn to True
37897>>>            WebSet pbRender of oCancelChangesBtn to True
37898>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37899>>>        End
37899>>>>
37899>>>    End_Procedure
