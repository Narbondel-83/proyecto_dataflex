37960>>>    Procedure SetActionButtons
37963>>>        tWebNavigateData NavigateData
37963>>>        tWebNavigateData NavigateData
37963>>>        Boolean bHasRecord
37963>>>        Handle hoDD
37963>>>
37963>>>        Get Server to hoDD
37964>>>        Get GetNavigateData to NavigateData
37965>>>        Get HasRecord of hoDD to bHasRecord
37966>>>
37966>>>        // let's hide all buttons and then Show the ones we want
37966>>>        WebSet pbRender of oEditBtn to False
37967>>>        WebSet pbRender of oSaveBtn to False
37968>>>        WebSet pbRender of oCancelChangesBtn to False
37969>>>        WebSet pbRender of oDeleteBtn to False
37970>>>
37970>>>        If (NavigateData.bReadOnly) Begin
37972>>>            WebSet pbRender of oEditBtn to True
37973>>>        End
37973>>>>
37973>>>        Else Begin
37974>>>            WebSet pbRender of oSaveBtn to True
37975>>>            WebSet pbRender of oCancelChangesBtn to True
37976>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37977>>>        End
37977>>>>
37977>>>    End_Procedure
