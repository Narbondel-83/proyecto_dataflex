37553>>>    Procedure SetActionButtons
37556>>>        tWebNavigateData NavigateData
37556>>>        tWebNavigateData NavigateData
37556>>>        Boolean bHasRecord
37556>>>        Handle hoDD
37556>>>
37556>>>        Get Server to hoDD
37557>>>        Get GetNavigateData to NavigateData
37558>>>        Get HasRecord of hoDD to bHasRecord
37559>>>
37559>>>        // let's hide all buttons and then Show the ones we want
37559>>>        WebSet pbRender of oEditBtn to False
37560>>>        WebSet pbRender of oSaveBtn to False
37561>>>        WebSet pbRender of oCancelChangesBtn to False
37562>>>        WebSet pbRender of oDeleteBtn to False
37563>>>
37563>>>        If (NavigateData.bReadOnly) Begin
37565>>>            WebSet pbRender of oEditBtn to True
37566>>>        End
37566>>>>
37566>>>        Else Begin
37567>>>            WebSet pbRender of oSaveBtn to True
37568>>>            WebSet pbRender of oCancelChangesBtn to True
37569>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37570>>>        End
37570>>>>
37570>>>    End_Procedure
