37570>>>    Procedure SetActionButtons
37573>>>        tWebNavigateData NavigateData
37573>>>        tWebNavigateData NavigateData
37573>>>        Boolean bHasRecord
37573>>>        Handle hoDD
37573>>>
37573>>>        Get Server to hoDD
37574>>>        Get GetNavigateData to NavigateData
37575>>>        Get HasRecord of hoDD to bHasRecord
37576>>>
37576>>>        // let's hide all buttons and then Show the ones we want
37576>>>        WebSet pbRender of oEditBtn to False
37577>>>        WebSet pbRender of oSaveBtn to False
37578>>>        WebSet pbRender of oCancelChangesBtn to False
37579>>>        WebSet pbRender of oDeleteBtn to False
37580>>>
37580>>>        If (NavigateData.bReadOnly) Begin
37582>>>            WebSet pbRender of oEditBtn to True
37583>>>        End
37583>>>>
37583>>>        Else Begin
37584>>>            WebSet pbRender of oSaveBtn to True
37585>>>            WebSet pbRender of oCancelChangesBtn to True
37586>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37587>>>        End
37587>>>>
37587>>>    End_Procedure
