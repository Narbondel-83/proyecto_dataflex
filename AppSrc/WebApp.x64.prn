37813>>>>>>>    Procedure SetActionButtons
37816>>>>>>>        tWebNavigateData NavigateData
37816>>>>>>>        tWebNavigateData NavigateData
37816>>>>>>>        Boolean bHasRecord
37816>>>>>>>        Handle hoDD
37816>>>>>>>
37816>>>>>>>        Get Server to hoDD
37817>>>>>>>        Get GetNavigateData to NavigateData
37818>>>>>>>        Get HasRecord of hoDD to bHasRecord
37819>>>>>>>
37819>>>>>>>        // let's hide all buttons and then Show the ones we want
37819>>>>>>>        WebSet pbRender of oEditBtn to False
37820>>>>>>>        WebSet pbRender of oSaveBtn to False
37821>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37822>>>>>>>        WebSet pbRender of oDeleteBtn to False
37823>>>>>>>
37823>>>>>>>        If (NavigateData.bReadOnly) Begin
37825>>>>>>>            WebSet pbRender of oEditBtn to True
37826>>>>>>>        End
37826>>>>>>>>
37826>>>>>>>        Else Begin
37827>>>>>>>            WebSet pbRender of oSaveBtn to True
37828>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37829>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37830>>>>>>>        End
37830>>>>>>>>
37830>>>>>>>    End_Procedure
37831>>>>>>>
37831>>>>>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37834>>>>>>>        // Close after save
37834>>>>>>>        Send NavigateClose Self
37835>>>>>>>    End_Procedure
37836>>>>>>>
37836>>>>>>>    // this will close the view after a delete
37836>>>>>>>    Procedure OnViewDeleted Handle hoDDO
37839>>>>>>>        Send NavigateClose Self
37840>>>>>>>    End_Procedure
