36728>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36731>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36732>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36735>>>>>>>        
36735>>>>>>>        If (bRequireTimeCost) Begin
36737>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36738>>>>>>>        End
36738>>>>>>>>
36738>>>>>>>        Else Begin
36739>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36740>>>>>>>        End
