37581>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37584>>>        Case Begin
37584>>>            Case (NavigateData.eNavigateType = nfFromMain)
37586>>>                // If from main, this is a propbably a main file Select to Zoom.
37586>>>                Case Break
37587>>>
37587>>>            Case (NavigateData.eNavigateType = nfFromParent)
37590>>>                // If from parent, this is a constrained drill down.
37590>>>                Case Break
37591>>>
37591>>>            Case (NavigateData.eNavigateType = nfFromChild)
37594>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37594>>>                Case Break
37595>>>
37595>>>            Case Else // must be nfUndefined
37595>>>
37595>>>        Case End
37595>>>
37595>>>        Send SetActionButtons
37596>>>
37596>>>    End_Procedure
