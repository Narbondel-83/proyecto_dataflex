36708>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36710>>>>>>>                Get CNG_PBKDF2_HMAC "SHA256" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36711>>>>>>>                If (not(bOk)) Function_Return False
36714>>>>>>>                
36714>>>>>>>                Move True to bRequireTimeCost
36715>>>>>>>                Case Break
36716>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36719>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36720>>>>>>>                If (not(bOk)) Function_Return False
36723>>>>>>>                
36723>>>>>>>                Move True to bRequireTimeCost
36724>>>>>>>                Case Break
36725>>>>>>>            Case Else
36725>>>>>>>                Error 8710 "Invalid algorithm selected."
36726>>>>>>>>
36726>>>>>>>                Function_Return False
36727>>>>>>>        Case End
36727>>>>>>>        
36727>>>>>>>        String sSalt
