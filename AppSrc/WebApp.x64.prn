38359>>>    Procedure SetActionButtons
38362>>>        tWebNavigateData NavigateData
38362>>>        tWebNavigateData NavigateData
38362>>>        Boolean bHasRecord
38362>>>        Handle hoDD
38362>>>
38362>>>        Get Server to hoDD
38363>>>        Get GetNavigateData to NavigateData
38364>>>        Get HasRecord of hoDD to bHasRecord
38365>>>
38365>>>        // let's hide all buttons and then Show the ones we want
38365>>>        WebSet pbRender of oEditBtn to False
38366>>>        WebSet pbRender of oSaveBtn to False
38367>>>        WebSet pbRender of oCancelChangesBtn to False
38368>>>        WebSet pbRender of oDeleteBtn to False
38369>>>
38369>>>        If (NavigateData.bReadOnly) Begin
38371>>>            WebSet pbRender of oEditBtn to True
38372>>>        End
38372>>>>
38372>>>        Else Begin
38373>>>            WebSet pbRender of oSaveBtn to True
38374>>>            WebSet pbRender of oCancelChangesBtn to True
38375>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38376>>>        End
38376>>>>
38376>>>    End_Procedure
