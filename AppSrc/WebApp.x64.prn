38546>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38549>>>        WebSet pbRender of oNewButton to True
38550>>>        WebSet pbRender of oDetailButton to True
38551>>>
38551>>>        Case Begin
38551>>>            Case (NavigateData.eNavigateType = nfFromParent)
38553>>>                // If from parent, this is a constrained drill down
38553>>>                Case Break
38554>>>
38554>>>            Case (NavigateData.eNavigateType = nfFromChild)
38557>>>                // If from child, this is a probably a parent lookup from a Zoom
38557>>>                Case Break
38558>>>
38558>>>            Case (NavigateData.eNavigateType = nfFromMain)
38561>>>                // If from main, this is a probably a main-file lookup from a Zoom
38561>>>                WebSet pbRender of oDetailButton to False
38562>>>                Case Break
38563>>>
38563>>>            Case Else // must be nfUndefined
38563>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38563>>>
38563>>>        Case End
38563>>>
38563>>>    End_Procedure
