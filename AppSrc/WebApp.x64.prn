38302>>>    Procedure SetActionButtons
38305>>>        tWebNavigateData NavigateData
38305>>>        tWebNavigateData NavigateData
38305>>>        Boolean bHasRecord
38305>>>        Handle hoDD
38305>>>
38305>>>        Get Server to hoDD
38306>>>        Get GetNavigateData to NavigateData
38307>>>        Get HasRecord of hoDD to bHasRecord
38308>>>
38308>>>        // let's hide all buttons and then Show the ones we want
38308>>>        WebSet pbRender of oEditBtn to False
38309>>>        WebSet pbRender of oSaveBtn to False
38310>>>        WebSet pbRender of oCancelChangesBtn to False
38311>>>        WebSet pbRender of oDeleteBtn to False
38312>>>
38312>>>        If (NavigateData.bReadOnly) Begin
38314>>>            WebSet pbRender of oEditBtn to True
38315>>>        End
38315>>>>
38315>>>        Else Begin
38316>>>            WebSet pbRender of oSaveBtn to True
38317>>>            WebSet pbRender of oCancelChangesBtn to True
38318>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38319>>>        End
38319>>>>
38319>>>    End_Procedure
