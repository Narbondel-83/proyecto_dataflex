38981>>>        tWebNavigateData NavigateData
38981>>>        tWebNavigateData NavigateData
38981>>>        Boolean bHasRecord
38981>>>        Handle hoDD
38981>>>
38981>>>        Get Server to hoDD
38982>>>        Get GetNavigateData to NavigateData
38983>>>        Get HasRecord of hoDD to bHasRecord
38984>>>
38984>>>        // let's hide all buttons and then Show the ones we want
38984>>>        WebSet pbRender of oEditBtn to False
38985>>>        WebSet pbRender of oSaveBtn to False
38986>>>        WebSet pbRender of oCancelChangesBtn to False
38987>>>        WebSet pbRender of oDeleteBtn to False
38988>>>
38988>>>        If (NavigateData.bReadOnly) Begin
38990>>>            WebSet pbRender of oEditBtn to True
38991>>>        End
38991>>>>
38991>>>        Else Begin
38992>>>            WebSet pbRender of oSaveBtn to True
38993>>>            WebSet pbRender of oCancelChangesBtn to True
38994>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38995>>>        End
38995>>>>
38995>>>    End_Procedure
